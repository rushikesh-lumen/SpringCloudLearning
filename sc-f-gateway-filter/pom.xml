        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId><!-- MIGRATED: spring-cloud-starter-netflix-hystrix removed, replaced with Spring Cloud Circuit Breaker Resilience4J -->
